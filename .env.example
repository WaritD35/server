# Pet-Plant server — configuration (template + committed defaults).
#
# Owned by the `core` context. This file is the single source of DEFAULT
# configuration: `core.config.Settings` declares only names and types and reads
# the values from here, then from `.env` (local overrides), then from real
# environment variables — each layer overrides the previous.
#
# Copy to `.env` to override locally; do not edit this file for a single machine.

# --- app ---
# APP_ENV: local | dev | staging | prod
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- PostgreSQL (single instance, one schema per context) ---
DATABASE_URL=postgresql+psycopg://petplant:petplant@localhost:5432/petplant

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_CAPTURES=captures
MINIO_BUCKET_FRAMES_DERIVED=frames-derived
MINIO_BUCKET_EXEMPLARS=exemplars
MINIO_BUCKET_EVAL_SETS=eval-sets

# --- auth (OAuth2 / JWT, role-based) ---
JWT_ISSUER=pet-plant
JWT_AUDIENCE=pet-plant-api
JWT_ALG=HS256
JWT_SECRET=dev-jwt-secret-min-32-chars-for-hmac-sha256
ACCESS_TOKEN_TTL_SECONDS=3600

# Bootstrap admin: created (or promoted to superuser) on web startup.
# Override ADMIN_PASSWORD via `.env` / real env vars for anything but local.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me

# --- orchestrator ---
# The pipeline schedule lives in this TOML file
# (relative to the working directory: the repo root locally, /app in the image).
ORCHESTRATOR_CONFIG=config/orchestrator.toml

# --- self-hosted inference (on-prem, called over the network; models not in this repo) ---
# VLM served with vLLM, OpenAI-compatible API
VLM_API_BASE=http://localhost:8001/v1
VLM_API_KEY=
VLM_MODEL=
SEGMENTATION_ENDPOINT=http://localhost:8100

# --- external LLM for advice / offline probe generation (text only; never images) ---
# Any OpenAI-compatible endpoint; reached through `langchain-openai` in `mlops`.
# There is deliberately no LLM_MODEL: which model a prompt runs on is part of
# that Langfuse prompt version's `config`, so it is versioned with the text it
# was tuned against and a run's model is recoverable from the version it names.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=

# --- Langfuse (prompt management, tracing, datasets; used by `mlops`) ---
# Langfuse is split by project — one per LLM-using component — so each component
# has its own key pair, and a component never falls through to another's project.
# See src/mlops/README.md.
#
# LANGFUSE_HOST is the region or your own instance:
#   https://cloud.langfuse.com      EU
#   https://us.cloud.langfuse.com   US
#   https://jp.cloud.langfuse.com   JP
#   http://localhost:3000           self-hosted
# The SDK's own LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_BASE_URL are
# NOT read by this project — the per-component names below are.
LANGFUSE_HOST=https://jp.cloud.langfuse.com
# Needed for the probe-generation agent and its experiments (project: knowledge).
LANGFUSE_KNOWLEDGE_PUBLIC_KEY=
LANGFUSE_KNOWLEDGE_SECRET_KEY=
# The remaining components are still templates; fill these in as each lands.
LANGFUSE_ASSESSMENT_PUBLIC_KEY=
LANGFUSE_ASSESSMENT_SECRET_KEY=
LANGFUSE_ADVICE_PUBLIC_KEY=
LANGFUSE_ADVICE_SECRET_KEY=
LANGFUSE_REGISTRY_PUBLIC_KEY=
LANGFUSE_REGISTRY_SECRET_KEY=
LANGFUSE_COMPANION_PUBLIC_KEY=
LANGFUSE_COMPANION_SECRET_KEY=
CONFIDENCE_THRESHOLD=0.5

# --- LLM Provider (openai | ollama) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
