          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monty\",\n  \"species_code\": \"spath\",\n  \"device_id\": \"{{deviceSerial}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/registry/plants",
              "host": ["{{baseUrl}}"],
              "path": ["registry", "plants"]
            }
          }
        },
        {
          "name": "1.7 Setup Unbound Device (for Scenario 7)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('unboundDeviceCode', res.device_code);",
                  "pm.collectionVariables.set('unboundUserCode', res.user_code);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"physical_id\": \"unbound_hardware_999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/pair",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "pair"]
            }
          }
        },
        {
          "name": "1.8 Approve & Get Unbound Device Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const approveReq = {",
                  "    url: pm.collectionVariables.get('baseUrl') + '/devices/pair/approve',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Authorization': 'Bearer ' + pm.collectionVariables.get('userToken'),",
                  "        'Content-Type': 'application/json'",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({ user_code: pm.collectionVariables.get('unboundUserCode') })",
                  "    }",
                  "};",
                  "pm.sendRequest(approveReq, function (err, res) {",
                  "    const tokenReq = {",
                  "        url: pm.collectionVariables.get('baseUrl') + '/devices/pair/token',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({ device_code: pm.collectionVariables.get('unboundDeviceCode') })",
                  "        }",
                  "    };",
                  "    pm.sendRequest(tokenReq, function (tErr, tRes) {",
                  "        pm.collectionVariables.set('unboundDeviceToken', tRes.json().access_token);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Companion State Scenarios",
      "item": [
        {
          "name": "Scenario 1: Unauthenticated (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"BaseResponse envelope format for error\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.data).to.be.null;",
                  "    pm.expect(res.error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"]
            }
          }
        },
        {
          "name": "Scenario 2: Invalid Bearer Token (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Error code is UNAUTHORIZED\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer totally_bogus_token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"]
            }
          }
        },
        {
          "name": "Scenario 3: User JWT Missing plant_id (Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Error code is PLANT_ID_REQUIRED\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.error.code).to.eql('PLANT_ID_REQUIRED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"]
            }
          }
        },
        {
          "name": "Scenario 4: User JWT Non-existent plant_id (Expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Error code is PLANT_NOT_FOUND\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.error.code).to.eql('PLANT_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state?plant_id=00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"],
              "query": [
                {
                  "key": "plant_id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            }
          }
        },
        {
          "name": "Scenario 5: User JWT Happy Path (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Envelope success is true and error is null\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.error).to.be.null;",
                  "});",
                  "pm.test(\"CompanionStateData schema validation\", function () {",
                  "    const data = res.data;",
                  "    pm.expect(data).to.be.an('object');",
                  "    pm.expect(data.plant_id).to.eql(pm.collectionVariables.get('plantId'));",
                  "    pm.expect(data.name).to.eql('Monty');",
                  "    pm.expect(data.dayCount).to.be.at.least(1);",
                  "    pm.expect(data.level).to.be.at.least(1);",
                  "    pm.expect(data.xpRatio).to.be.within(0.0, 1.0);",
                  "    pm.expect(['healthy', 'possibly_unhealthy', 'unhealthy']).to.include(data.health_status);",
                  "    pm.expect(['NO_ACTION', 'CARE_ADVICE_REQUIRED', 'REQUEST_MORE_INFORMATION']).to.include(data.decision);",
                  "    pm.expect(data.companion_message).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state?plant_id={{plantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"],
              "query": [
                {
                  "key": "plant_id",
                  "value": "{{plantId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Scenario 6: Edge Device Token Happy Path (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Device resolves plant automatically without plant_id param\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.plant_id).to.eql(pm.collectionVariables.get('plantId'));",
                  "    pm.expect(res.data.name).to.eql('Monty');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{deviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"]
            }
          }
        },
        {
          "name": "Scenario 7: Unbound Device Token (Expect 404 DEVICE_NOT_BOUND)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Error code is DEVICE_NOT_BOUND\", function () {",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.error.code).to.eql('DEVICE_NOT_BOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{unboundDeviceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companion/devices/me/state",
              "host": ["{{baseUrl}}"],
              "path": ["companion", "devices", "me", "state"]
            }
          }
        },
        {
          "name": "Scenario 8: Swagger OpenAPI Schema Verification (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const spec = pm.response.json();",
                  "pm.test(\"Companion tag registered in OpenAPI\", function () {",
                  "    const tagNames = spec.tags.map(t => t.name);",
                  "    pm.expect(tagNames).to.include('Companion');",
                  "});",
                  "pm.test(\"Endpoint documented with all status codes\", function () {",
                  "    const ep = spec.paths['/companion/devices/me/state'].get;",
                  "    pm.expect(ep.summary).to.eql('Get current companion device state');",
                  "    pm.expect(ep.responses).to.have.property('200');",
                  "    pm.expect(ep.responses).to.have.property('400');",
                  "    pm.expect(ep.responses).to.have.property('401');",
                  "    pm.expect(ep.responses).to.have.property('403');",
                  "    pm.expect(ep.responses).to.have.property('404');",
                  "    pm.expect(ep.responses).to.have.property('500');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": ["{{baseUrl}}"],
              "path": ["openapi.json"]
            }
          }
        }
