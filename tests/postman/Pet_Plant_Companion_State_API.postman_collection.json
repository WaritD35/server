              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 100000);",
                  "const email = 'user_' + rand + '@example.com';",
                  "pm.collectionVariables.set('userEmail', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"name\": \"Test User\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Login User (Get JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Access token exists\", function () {",
                  "    pm.expect(res.access_token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('userToken', res.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{userEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{userPassword}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            }
          }
        },
        {
          "name": "1.3 Start Device Pairing",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 100000);",
                  "const serial = 'edge_device_' + rand;",
                  "pm.collectionVariables.set('deviceSerial', serial);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('deviceCode', res.device_code);",
                  "pm.collectionVariables.set('userCode', res.user_code);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"physical_id\": \"{{deviceSerial}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/pair",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "pair"]
            }
          }
        },
        {
          "name": "1.4 Approve Device Pairing (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"{{userCode}}\",\n  \"name\": \"Living Room Planter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/pair/approve",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "pair", "approve"]
            }
          }
        },
        {
          "name": "1.5 Exchange Code for Device Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Device token starts with ppd_\", function () {",
                  "    pm.expect(res.access_token).to.match(/^ppd_/);",
                  "});",
                  "pm.collectionVariables.set('deviceToken', res.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_code\": \"{{deviceCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/pair/token",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "pair", "token"]
            }
          }
        },
        {
          "name": "1.6 Register Plant (Bound to Device)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('plantId', res.id);"
                ],
                "type": "text/javascript"
              }
